# JWT Secret (REQUIRED - generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here

# AI Provider API Keys (at least one recommended)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# Optional: Custom API URL for v0 SDK
# V0_API_URL=

# Free with vision: Google Gemini API (no credit card, 1M token context, free vision)
# Get key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# FreeTheAi (Discord signup, daily checkin, 50+ models free)
# Get key: Join https://discord.gg/secrets → /signup → /checkin daily
FREETHEAI_API_KEY=

# Free alternative: Groq API (no credit card, 500K tokens/day free)
# Sign up at https://console.groq.com
GROQ_API_KEY=

# Database (SQLite by default, no config needed)
