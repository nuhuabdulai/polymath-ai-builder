# JWT Secret (REQUIRED - generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here

# AI Provider API Keys (at least one recommended)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=

# Optional: Custom API URL for v0 SDK
# V0_API_URL=

# Free with vision: Google Gemini API (no credit card, 1M token context, free vision)
# Get key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# FreeTheAi (Discord signup, daily checkin, 50+ models free)
# Get key: Join https://discord.gg/secrets → /signup → /checkin daily
FREETHEAI_API_KEY=

# Groq API (no credit card, free tier)
# Sign up at https://console.groq.com
GROQ_API_KEY=

# Cerebras (no credit card, fastest inference, 1M tokens/day free)
# Sign up at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# DeepSeek (5M free tokens on signup)
# Sign up at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# GitHub Models (45+ models, free with GitHub account)
# Get key at https://github.com/settings/tokens
GITHUB_API_KEY=

# Database (SQLite by default, no config needed)
